# Copy to .cline/.env to enable the shared Cline proxy.
UPSTREAM_API_KEY=replace-with-your-provider-key
UPSTREAM_URL=https://api.openai.com
UPSTREAM_AUTH_HEADER=Authorization
UPSTREAM_AUTH_SCHEME=Bearer
# Optional JSON mapping of Cline model names to upstream model identifiers.
MODEL_MAP={}
# Optional JSON mapping of incoming path prefixes to upstream path prefixes.
ROUTE_MAP={}